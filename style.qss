/* Professional Medical Theme - Balanced */

QMainWindow {
    background-color: #f0f2f1;
}

QWidget {
    font-family: 'Segoe UI', 'Roboto', 'Arial', sans-serif;
    font-size: 11pt;
    color: #2c3e50;
}

/* TOP BUTTONS - Subtle and Clean */
QPushButton {
    background-color: #2c5f2d;
    color: white;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 10pt;
    border: 1px solid #1e4d1f;
}

QPushButton:hover {
    background-color: #3d8c40;
}

QPushButton:pressed {
    background-color: #1a3a1b;
}

/* Red Exit Button */
QPushButton#pbSalir {
    background-color: #c0392b;
    border-color: #922b21;
}
QPushButton#pbSalir:hover {
    background-color: #e74c3c;
}

/* PATIENT INFO LABELS */
QLabel#lNombre {
    font-size: 14pt;
    font-weight: bold;
    color: #1a4d2e;
    padding: 5px;
}

QLabel#lEdad, QLabel#lOtrosDatos, QLabel#labelTelefono {
    background-color: #e8f5e9;
    border: 1px solid #c8e6c9;
    padding: 2px 8px;
    border-radius: 4px;
    color: #2e7d32;
}

/* TABS */
QTabWidget::pane {
    border: 1px solid #d0d7d4;
    background-color: white;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #e0e6e3;
    border: 1px solid #d0d7d4;
    border-bottom: none;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: white;
    border-bottom: 2px solid white;
    font-weight: bold;
    color: #2c5f2d;
}

/* GROUP BOXES */
QGroupBox {
    border: 1px solid #d0d7d4;
    border-radius: 6px;
    margin-top: 1.5ex;
    font-weight: bold;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
}

/* TABLES & INPUTS */
QTableView, QListWidget, QTextEdit, QLineEdit {
    border: 1px solid #d0d7d4;
    border-radius: 4px;
    background-color: white;
    gridline-color: #e0e0e0; /* Visible Grid */
}

QHeaderView::section {
    background-color: #ebf0ee;
    padding: 8px;
    border: 1px solid #d0d7d4;
    font-weight: bold;
    color: #2c5f2d;
}

QTableView {
    selection-background-color: #dff2e8;
    selection-color: #1a4d2e;
    alternate-background-color: #f9fbfb;
}

/* Scrollbars */
QScrollBar:vertical {
    width: 12px;
    background: #f1f1f1;
}
QScrollBar::handle:vertical {
    background: #c1cdc8;
    border-radius: 6px;
}
